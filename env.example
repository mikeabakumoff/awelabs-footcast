# Copy to a file named env (no dot) in the project root and fill in.
# The loader reads plain KEY=VALUE lines; never commit the filled file.

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Channel the forecasts are published to
CHAT_ID=

# Personal chat id for operational notifications
OWNER_CHAT_ID=

# Mini App URL opened from the bot, if used
WEB_APP_URL=

# api-sports.io — fixtures, lineups, injuries, standings
API_FOOTBALL_KEY=

# the-odds-api.com — bookmaker odds
ODDS_API_KEY=

# Anthropic — the news-adjustment pass
ANTHROPIC_API_KEY=